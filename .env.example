# Optional: securely set ADMIN_PASSWORD before the first start, at least 10 characters.
# Otherwise use the one-time key in data/setup-key.txt to set up /admin.
ADMIN_PASSWORD=
PORT=3000
# Set true for HTTPS deployment (leave false for local HTTP).
COOKIE_SECURE=false
# Required for automatic WhatsApp invoices; use your real public HTTPS origin.
PUBLIC_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_API_VERSION=v23.0
# Free Render: set a Neon/PostgreSQL connection string privately. Never commit it.
DATABASE_URL=
# SQLite fallback only when DATABASE_URL is absent. Requires a writable persistent
# directory in production. DATABASE_URL takes priority over DATA_FILE.
# DATA_FILE=
